# Same Firebase project as apps/api, but the Web app's public config (not the service account)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Leave empty for same-origin deployments (default - works with the Vite dev proxy at
# /api -> http://localhost:3000, see vite.config.ts, and with the production ingress
# where Admin and the API share one host). The generated OpenAPI `paths` already carry
# the full /api/v1/... prefix, so this must NOT also include /api/v1, or every request
# gets double-prefixed. Only set this if Admin and the API are split across different
# origins, to that origin's bare host (no /api/v1 suffix).
VITE_API_BASE_URL=
