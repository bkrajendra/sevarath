# Same Firebase project as apps/api, but the Web app's public config (not the service account)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Defaults to the Vite dev proxy (/api -> http://localhost:3000, see vite.config.ts).
# Override for a build pointed at a deployed API.
VITE_API_BASE_URL=/api/v1
