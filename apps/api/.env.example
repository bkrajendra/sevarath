# Server
PORT=3000
NODE_ENV=development

# Database (docker-compose maps the container's 5432 to host 5433 to avoid clashing
# with a pre-existing local Postgres on 5432 - adjust if your setup differs)
DATABASE_URL=postgres://sevarath:sevarath@localhost:5433/sevarath

# Redis (container's 6379 mapped to host 6380 for the same reason)
REDIS_URL=redis://localhost:6380

# JWT (app-issued access/refresh tokens, after Firebase verification)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=30d

# Firebase Authentication (service account for firebase-admin)
# Download a service account JSON from Firebase console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep literal \n escapes; firebase-admin expects the PEM with real newlines, converted at load time
FIREBASE_PRIVATE_KEY=

# Valhalla routing engine (self-hosted - see k8s/maps/README.md). Defaults to the
# in-cluster service name; override for local dev via `kubectl port-forward`.
VALHALLA_URL=http://sevarath-valhalla:8002
